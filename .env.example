# Ollama runs locally — no API key required.
# All settings below are optional with sensible defaults.

# Which Ollama model to use. Must be one you've pulled (e.g. `ollama pull qwen2.5:14b`).
# Recommended for this project:
#   qwen2.5:14b       - best tool-use accuracy (~9GB RAM)
#   llama3.1:8b       - good balance (~5GB RAM)
#   qwen2.5:7b        - lighter (~5GB RAM)
# UAE_COPILOT_MODEL=qwen2.5:14b

# Ollama API endpoint. Default is local. Override if Ollama runs on another host.
# UAE_COPILOT_OLLAMA_HOST=http://localhost:11434

# Other overrides
# UAE_COPILOT_DATA_DIR=./data
# UAE_COPILOT_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# UAE_COPILOT_LOG_LEVEL=INFO
